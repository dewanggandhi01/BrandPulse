# ============================================================
# BrandPulse Environment Configuration
# Copy to .env and adjust values for your environment
# ============================================================

# === Database (PostgreSQL 17) ===
# For Docker Compose: use service name 'postgres'
# For local dev: use 'localhost'
DATABASE_URL=postgresql+asyncpg://brandpulse:brandpulse@postgres:5432/brandpulse
POSTGRES_USER=brandpulse
POSTGRES_PASSWORD=brandpulse
POSTGRES_DB=brandpulse

# === Redis 7.4 ===
# For Docker Compose: use service name 'redis'
# For local dev: use 'localhost'
REDIS_URL=redis://redis:6379/0

# === Celery Task Queue ===
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === FastAPI Application ===
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=INFO

# === LLM Integration (optional, for future phases) ===
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
